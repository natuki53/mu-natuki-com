[Unit]
Description=Private home-server monitoring collector (read-only probes)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=natuki
Group=natuki
WorkingDirectory=/home/natuki/services/monitoring/code
ExecStart=/usr/bin/python3 -B /home/natuki/services/monitoring/code/monitoring_collector.py --config /home/natuki/services/monitoring/config/collector.json
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Restart=always
RestartSec=15
UMask=0077
# crontab -l needs the packaged crontab binary's setgid permission on both hosts.
# Disabling privilege gains would silently make the actual next schedules unreadable.
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
Nice=10
CPUQuota=50%
MemoryMax=384M
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
